# ── ProcureFlow AI — Variables de Entorno ────────────────────────────────────
# Copiar como .env y reemplazar TODOS los valores marcados con <CAMBIAR>

# ── Aplicación ────────────────────────────────────────────────────────────────
APP_NAME=ProcureFlow AI
APP_ENV=production            # development | staging | production
APP_VERSION=2.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=4
DEBUG=False

# ── CRÍTICO: Cambiar antes de cualquier despliegue ───────────────────────────
SECRET_KEY=<CAMBIAR: mínimo 50 caracteres aleatorios>
JWT_SECRET_KEY=<CAMBIAR: mínimo 50 caracteres aleatorios>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Base de Datos ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://procureflow:<CAMBIAR:password>@localhost:5432/procureflow_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_ECHO=False

# Alternativa para docker-compose (usar nombre del servicio)
# DATABASE_URL=postgresql+asyncpg://procureflow:<password>@db:5432/procureflow_db

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=300

# ── PostgreSQL (solo para docker-compose) ────────────────────────────────────
POSTGRES_USER=procureflow
POSTGRES_PASSWORD=<CAMBIAR:password>
POSTGRES_DB=procureflow_db

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Seguridad ─────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_HOSTS=*
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
BCRYPT_ROUNDS=12

# ── AI ────────────────────────────────────────────────────────────────────────
AI_PROVIDER=none              # none | openai | anthropic
OPENAI_API_KEY=               # Dejar vacío si no se usa
OPENAI_MODEL=gpt-4-turbo-preview
ANTHROPIC_API_KEY=            # Dejar vacío si no se usa

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<CAMBIAR:tu-email@gmail.com>
SMTP_PASSWORD=<CAMBIAR:app-password>
EMAIL_FROM=noreply@procureflow.com

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_BACKEND=local         # local | s3
UPLOAD_PATH=./uploads
MAX_FILE_SIZE_MB=25
# S3_BUCKET=
# S3_REGION=

# ── Reglas de Negocio ─────────────────────────────────────────────────────────
MAX_PO_AMOUNT_AUTO_APPROVE=5000.00
APPROVAL_TIMEOUT_HOURS=72
NOTIFICATION_REMINDER_HOURS=24
BUDGET_ALERT_THRESHOLD_PERCENT=80
CURRENCY_DEFAULT=USD

# ── Observabilidad ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json               # json | console
