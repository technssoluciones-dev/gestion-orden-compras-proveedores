              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Obtain access and refresh tokens",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@procureflow.com\",\n  \"password\": \"Admin1234!\"\n}",
